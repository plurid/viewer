{
  "name": "viewer-workspace",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=11" },
  "scripts": {
    "plurid:sync": "pnpm --filter viewer-electron plurid:sync",
    "plurid:update": "pnpm --filter viewer-electron plurid:update",
    "plurid:check": "pnpm --filter viewer-electron plurid:check",
    "start": "pnpm --filter viewer-electron start",
    "check": "pnpm --filter viewer-electron check",
    "lint": "pnpm --filter viewer-electron lint",
    "format": "pnpm --filter viewer-electron format",
    "format:check": "pnpm --filter viewer-electron format:check",
    "test": "pnpm --filter viewer-electron test",
    "test:browser": "pnpm --filter viewer-electron test:browser",
    "test:desktop": "pnpm --filter viewer-electron test:desktop",
    "test:mas": "pnpm --filter viewer-electron test:mas",
    "qualify": "pnpm --filter viewer-electron qualify",
    "direct:release": "pnpm --filter viewer-electron direct:release",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm package",
    "package": "pnpm --filter viewer-electron package",
    "make": "pnpm --filter viewer-electron make",
    "mas:preflight": "pnpm --filter viewer-electron mas:preflight",
    "mas:dev": "pnpm --filter viewer-electron mas:dev",
    "mas:package": "pnpm --filter viewer-electron mas:package"
  }
}

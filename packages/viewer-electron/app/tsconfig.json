{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "baseUrl": ".",
        "outDir": "dist",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "jsx": "react-jsx",

        "paths": {
            "~source/*": [
                "./src/*"
            ],
            "~renderer-data/*": [
                "./src/app/modules/data/*"
            ],
            "~renderer-components/*": [
                "./src/app/modules/components/*"
            ],
            "~renderer-containers/*": [
                "./src/app/modules/containers/*"
            ],
            "~renderer-planes/*": [
                "./src/app/modules/planes/*"
            ],
            "~renderer-services/*": [
                "./src/app/modules/services/*"
            ],
        },
    }
}

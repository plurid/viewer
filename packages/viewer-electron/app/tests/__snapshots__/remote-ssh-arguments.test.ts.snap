// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fixed OpenSSH argv > snapshots a clicked master with every record option 1`] = `
{
  "args": [
    "-S",
    "/tmp/100%%/c1",
    "-o",
    "ControlMaster=yes",
    "-o",
    "ConnectTimeout=15",
    "-o",
    "ServerAliveInterval=15",
    "-o",
    "ServerAliveCountMax=3",
    "-o",
    "BatchMode=no",
    "-o",
    "ClearAllForwardings=yes",
    "-o",
    "ForwardAgent=no",
    "-o",
    "ForwardX11=no",
    "-o",
    "PermitLocalCommand=no",
    "-o",
    "RequestTTY=no",
    "-o",
    "LogLevel=ERROR",
    "-p",
    "2222",
    "-l",
    "builder",
    "-J",
    "first,bob@[2001:db8::1]:2200",
    "-i",
    "/keys/100%% key",
    "-o",
    "IdentitiesOnly=yes",
    "-f",
    "-N",
    "-M",
    "-o",
    "ControlPersist=600",
    "--",
    "::1",
  ],
  "executable": "/usr/bin/ssh",
}
`;


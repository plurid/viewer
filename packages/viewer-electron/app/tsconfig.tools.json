{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "src/domain/**/*.ts",
    "src/desktop/**/*.ts",
    "src/renderer/previews/prism-components.d.ts"
  ]
}

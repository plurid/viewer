{
  "name": "viewer-electron",
  "productName": "Viewer",
  "version": "0.1.0",
  "description": "A spatial file manager with modular, powerful previews",
  "keywords": [
    "viewer",
    "enhanced image",
    "enhanced video",
    "enhanced sound",
    "enhanced text"
  ],
  "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/viewer"
  },
  "bugs": {
    "email": "source@plurid.com",
    "url": "https://github.com/plurid/viewer/issues"
  },
  "homepage": "https://plurid.com/viewer",
  "publishConfig": {
    "access": "restricted"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "tsx tools/build-helpers.ts && electron-forge start",
    "check": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tools.json",
    "lint": "eslint src tests tools *.ts",
    "format": "prettier --write src tests tools *.ts *.json *.mjs *.html",
    "format:check": "prettier --check src tests tools *.ts *.json *.mjs *.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "tsx tests/browser-server.ts",
    "test:desktop": "tsx tests/electron-smoke.ts",
    "test:mas": "tsx tests/mas-native.ts",
    "qualify": "tsx tools/qualification.ts",
    "direct:release": "tsx tools/direct-release.ts",
    "package": "tsx tools/build-helpers.ts && electron-forge package",
    "make": "tsx tools/build-helpers.ts && electron-forge make",
    "mas:preflight": "tsx tools/mas.ts preflight",
    "mas:dev": "tsx tools/mas.ts dev",
    "mas:package": "tsx tools/mas.ts distribution"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "^2.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mime-types": "^3.0.0",
    "@types/node": "^26.0.0",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "44.7.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@plurid/plurid-data": "0.0.0-26",
    "@plurid/plurid-react": "0.0.0-40",
    "@tanstack/react-virtual": "^3.13.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "dxf-parser": "1.1.2",
    "fflate": "^0.8.2",
    "jsonc-parser": "^3.3.1",
    "mime-types": "^3.0.1",
    "node-pty": "^1.1.0",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.4.299",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.2",
    "three": "0.186.1",
    "zod": "^4.0.0"
  },
  "type": "module"
}

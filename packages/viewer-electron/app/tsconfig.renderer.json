{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/domain/**/*.ts"
  ]
}
